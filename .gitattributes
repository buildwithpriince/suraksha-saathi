*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.ttc filter=lfs diff=lfs merge=lfs -text
# Native and managed plugins (BouncyCastle, ZXing, SQLite)
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
# Documents and archives (printable markers)
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
# Unity writes lighting data as binary even with Force Text serialization
LightingData.asset filter=lfs diff=lfs merge=lfs -text

# Dashboard assets stay in plain git: Vercel does not fetch LFS files unless enabled per project.
# Must stay below the LFS rules so it overrides them.
dashboard/** !filter !diff !merge
