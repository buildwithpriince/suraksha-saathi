# NOTE: never add a bare `*~` pattern: it would hide app-unity/CoreTests~/ (the Core test project).

# Unity (project lives in app-unity/)
app-unity/[Ll]ibrary/
app-unity/[Tt]emp/
app-unity/[Oo]bj/
app-unity/[Bb]uild/
app-unity/[Bb]uilds/
app-unity/[Ll]ogs/
app-unity/[Uu]ser[Ss]ettings/
app-unity/[Mm]emoryCaptures/
app-unity/[Rr]ecordings/
app-unity/.utmp/
app-unity/.gradle/
app-unity/ExportedObj/
app-unity/.consulo/
app-unity/.vscode/
app-unity/[Aa]ssets/Plugins/Editor/JetBrains*
# IDE project files Unity regenerates (anchored: CoreTests~/*.csproj must stay tracked)
app-unity/*.csproj
app-unity/*.unityproj
app-unity/*.sln
app-unity/*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*
crashlytics-build.properties
# Generated copy of /content (Editor script copies it in, T-08; see docs/DECISIONS.md D-009)
app-unity/[Aa]ssets/[Ss]treamingAssets/content/
app-unity/[Aa]ssets/[Ss]treamingAssets/content.meta
# Build outputs
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
*.apk
*.aab
*.unitypackage
app-unity/CoreTests~/bin/
app-unity/CoreTests~/obj/
TestResults/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Node
node_modules/
dashboard/dist/
dashboard/dist-ssr/
dashboard/coverage/
.vercel/
*.tsbuildinfo
.eslintcache
vite.config.*.timestamp-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets (templates like backend/.env.example stay tracked)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
**/keys/

