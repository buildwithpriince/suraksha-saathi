# Copy to backend/.env for local runs (.env is gitignored; tests never read it).
# On Render, set these as environment variables instead. Blank values count as unset.

# Local default matches docker-compose.yml
DATABASE_URL=postgresql://suraksha:suraksha@localhost:5432/suraksha

# Supabase project (admin auth, docs/06)
SUPABASE_URL=
SUPABASE_JWKS_URL=

# Root Ed25519 private key: base64url (no padding) of the raw 32-byte seed, 43 chars (docs/04).
# Generate once: `uv run python -m app.tools.gen_root_key`; it also writes the public key file.
# Store it only in Render env vars. Never commit it, log it, or paste it anywhere else.
ROOT_SIGNING_KEY_B64=

# Comma-separated dashboard origins, e.g. http://localhost:5173,https://<dashboard>.vercel.app
CORS_ORIGINS=http://localhost:5173
